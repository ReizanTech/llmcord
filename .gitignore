# This gitignore is a whitelist. Inspired by https://rgbcu.be/blog/gitignore

*

!.gitignore

!*.md
!*.py

!Dockerfile
!config.yaml
!docker-compose.yaml
!requirements.txt

# RAG support package and its index builder
!rag/
!rag/*.py
!build_knowledge_index.py

# Support knowledge base (.md files the bot retrieves from)
!knowledge_base/
!knowledge_base/*.md

# documentation
!docs/
!docs/*.md

# tests
!tests/
!tests/*.py
